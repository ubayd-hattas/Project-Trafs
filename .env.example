# Copy to .env.local for local testing. In production, set these in Vercel.
# See docs/HANDOVER.md.

# Where the school's WordPress (news, past papers, staff login) lives.
NEXT_PUBLIC_WORDPRESS_URL=https://trafalgarhighschool.co.za

# Public address of this website. Vercel sets a preview address if empty.
NEXT_PUBLIC_SITE_URL=

# Set to true once the school adopts the site (allows search engines).
NEXT_PUBLIC_OFFICIAL_SITE=false
